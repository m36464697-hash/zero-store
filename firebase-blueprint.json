    "Voucher": {
      "title": "Voucher",
      "description": "Redeemable voucher providing either site wallet balance credit or product discount with expiry.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_\\-]+$",
          "minLength": 3,
          "maxLength": 28,
          "description": "Uppercase redeemable voucher code."
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Voucher display title."
        },
        "voucherType": {
          "type": "string",
          "enum": ["balance", "discount_percent", "discount_fixed"],
          "description": "Credits site balance or discounts products."
        },
        "value": {
          "type": "number",
          "description": "Currency value or discount percentage."
        },
        "minOrderAmount": {
          "type": "number",
          "description": "Minimum order subtotal for discount vouchers."
        },
        "maxUses": {
          "type": "number",
          "description": "Maximum total redemptions allowed."
        },
        "usedCount": {
          "type": "number",
          "description": "Number of times redeemed so far."
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Expiration timestamp."
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether voucher can be redeemed."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp."
        }
      },
      "required": [
        "code",
        "title",
        "voucherType",
        "value",
        "minOrderAmount",
        "maxUses",
        "usedCount",
        "expiresAt",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "VoucherRedemption": {
      "title": "VoucherRedemption",
      "description": "Per-user redemption lock preventing duplicate redemption of a voucher.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "voucherId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "code": {
          "type": "string",
          "maxLength": 28
        },
        "redeemedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "voucherId", "code", "redeemedAt"]
    },
    "SavedVoucher": {
      "title": "SavedVoucher",
      "description": "Discount voucher saved to a customer's profile after redemption.",
      "type": "object",
      "properties": {
        "voucherId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "code": { "type": "string", "minLength": 3, "maxLength": 28 },
        "title": { "type": "string", "minLength": 2, "maxLength": 80 },
        "voucherType": { "type": "string", "enum": ["discount_percent", "discount_fixed"] },
        "value": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["voucherId", "code", "title", "voucherType", "value", "minOrderAmount", "expiresAt", "savedAt"]
    },
    "SiteNotification": {
      "title": "SiteNotification",
      "description": "Time-limited announcement, order tracking alert, or voucher broadcast shown in top notification bell.",
      "type": "object",
      "properties": {
        "targetUserId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "'all' for global announcements/vouchers, or specific user UID."
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "minLength": 2,
          "maxLength": 360
        },
        "notifType": {
          "type": "string",
          "enum": ["order_tracking", "news", "voucher"]
        },
        "voucherCode": {
          "type": "string",
          "maxLength": 28
        },
        "orderNumber": {
          "type": "string",
          "maxLength": 20
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "targetUserId",
        "title",
        "message",
        "notifType",
        "voucherCode",
        "orderNumber",
        "expiresAt",
        "createdAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator membership document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Admin Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120,
          "description": "Admin email address."
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp admin role was granted."
        }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "ProductReview": {
      "title": "ProductReview",
      "description": "Verified customer rating and review tied to a completed order.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "productId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "productTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "orderId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "rating": {
          "type": "number"
        },
        "comment": {
          "type": "string",
          "minLength": 2,
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "customerName",
        "productId",
        "productTitle",
        "orderId",
        "rating",
        "comment",
        "createdAt"
      ]
    },
    "SupportThread": {
      "title": "SupportThread",
      "description": "Live technical support conversation thread per customer.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 120
        },
        "lastMessage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "lastSenderRole": {
          "type": "string",
          "enum": ["user", "admin"]
        },
        "unreadByAdmin": {
          "type": "boolean"
        },
        "unreadByUser": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "customerName",
        "customerEmail",
        "lastMessage",
        "lastSenderRole",
        "unreadByAdmin",
        "unreadByUser",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "Individual message inside a customer support thread.",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "senderRole": {
          "type": "string",
          "enum": ["user", "admin"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["senderId", "senderName", "senderRole", "text", "createdAt"]
    },
    "FlashDeal": {
      "title": "FlashDeal",
      "description": "Time-limited flash sale deal linked to a catalog product package.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 80 },
        "productId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "minLength": 1, "maxLength": 128 },
        "productTitle": { "type": "string", "minLength": 1, "maxLength": 80 },
        "packageId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "packageName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "imageUrl": { "type": "string", "minLength": 1, "maxLength": 850000 },
        "originalPrice": { "type": "number" },
        "flashPrice": { "type": "number" },
        "startsAt": { "type": "string", "format": "date-time" },
        "endsAt": { "type": "string", "format": "date-time" },
        "maxStock": { "type": "number" },
        "claimedCount": { "type": "number" },
        "isActive": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title", "productId", "productTitle", "packageId", "packageName",
        "imageUrl", "originalPrice", "flashPrice", "startsAt", "endsAt",
        "maxStock", "claimedCount", "isActive", "sortOrder", "updatedAt"
      ]
    },
    "ValueBundle": {
      "title": "ValueBundle",
      "description": "Curated multi-product value bundle with combined savings price.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 80 },
        "subtitle": { "type": "string", "minLength": 2, "maxLength": 160 },
        "badge": { "type": "string", "maxLength": 40 },
        "imageUrl": { "type": "string", "minLength": 1, "maxLength": 850000 },
        "items": { "type": "array", "description": "Bounded list of included product packages (max 6)." },
        "originalTotalPrice": { "type": "number" },
        "bundlePrice": { "type": "number" },
        "accentColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "minLength": 7, "maxLength": 7 },
        "deliveryType": { "type": "string", "enum": ["direct_id", "voucher_code", "subscription_login", "account_delivery"] },
        "requiresPlayerId": { "type": "boolean" },
        "playerIdLabel": { "type": "string", "maxLength": 60 },
        "isActive": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title", "subtitle", "badge", "imageUrl", "items",
        "originalTotalPrice", "bundlePrice", "accentColor", "deliveryType",
        "requiresPlayerId", "playerIdLabel", "isActive", "sortOrder", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/siteConfig/{configId}": {
      "schema": { "$ref": "#/entities/SiteConfig" },
      "description": "Global storefront configuration document (main)."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Dynamic storefront categories managed by admins."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Catalog of digital products across dynamic categories."
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Promotional discount codes."
    },
    "/paymentMethods/{methodId}": {
      "schema": { "$ref": "#/entities/PaymentMethod" },
      "description": "Electronic wallet payment channels."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "User orders with admin-verified tracking status and fulfillment details."
    },
    "/topupRequests/{topupId}": {
      "schema": { "$ref": "#/entities/TopupRequest" },
      "description": "Customer wallet balance top-up requests reviewed by admins."
    },
    "/vouchers/{voucherId}": {
      "schema": { "$ref": "#/entities/Voucher" },
      "description": "Timed vouchers for balance credit or product discounts."
    },
    "/vouchers/{voucherId}/redemptions/{userId}": {
      "schema": { "$ref": "#/entities/VoucherRedemption" },
      "description": "Per-user voucher redemption lock."
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/SiteNotification" },
      "description": "Timed order tracking, site news, and voucher broadcast notifications."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/ProductReview" },
      "description": "Verified customer product ratings and reviews."
    },
    "/supportThreads/{threadId}": {
      "schema": { "$ref": "#/entities/SupportThread" },
      "description": "Customer technical support chat threads."
    },
    "/supportThreads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/SupportMessage" },
      "description": "Messages inside a customer technical support thread."
    },
    "/publicActivity/{activityId}": {
      "schema": { "$ref": "#/entities/PublicActivity" },
      "description": "Anonymized live purchase feed for bottom-left social proof notifications."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profile documents including wallet balance."
    },
    "/users/{userId}/savedVouchers/{voucherId}": {
      "schema": { "$ref": "#/entities/SavedVoucher" },
      "description": "Discount vouchers redeemed by the user."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted admin role registry."
    },
    "/flashDeals/{dealId}": {
      "schema": { "$ref": "#/entities/FlashDeal" },
      "description": "Limited-time flash deal promotions."
    },
    "/bundles/{bundleId}": {
      "schema": { "$ref": "#/entities/ValueBundle" },
      "description": "Curated value saving bundles combining multiple digital items."
    }
  }
}
