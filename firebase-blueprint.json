        },
        "productTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Purchased item label."
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "description": "Region or city label."
        },
        "amountLabel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 30,
          "description": "Formatted amount paid."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "userId",
        "displayName",
        "productTitle",
        "city",
        "amountLabel",
        "createdAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account details and site balance isolated by owner UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "User full or display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120,
          "description": "User email address."
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Preferred e-wallet phone number."
        },
        "walletBalance": {
          "type": "number",
          "description": "Available storefront account balance."
        },
        "lastVoucherId": {
          "type": "string",
          "maxLength": 128,
          "description": "Last redeemed balance voucher ID for atomic verification."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account registration timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Profile last update timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "phone",
        "walletBalance",
        "lastVoucherId",
        "createdAt",
        "updatedAt"
      ]
    },
    "TopupRequest": {
      "title": "TopupRequest",
      "description": "Customer request to top up their in-site wallet balance via e-wallet transfer.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Owner Firebase Auth UID."
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Customer display name."
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 120,
          "description": "Customer email."
        },
        "referenceCode": {
          "type": "string",
          "pattern": "^TOP-[0-9]{5,10}$",
          "minLength": 9,
          "maxLength": 16,
          "description": "Auto-generated top-up reference number."
        },
        "amount": {
          "type": "number",
          "description": "Requested balance top-up amount."
        },
        "currencySymbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "description": "Currency symbol snapshot."
        },
        "paymentMethodId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Electronic wallet ID used."
        },
        "paymentMethodName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Electronic wallet name."
        },
        "walletSenderPhone": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "description": "Sender wallet phone number."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
