        "customerName",
        "customerEmail",
        "referenceCode",
        "amount",
        "currencySymbol",
        "paymentMethodId",
        "paymentMethodName",
        "walletSenderPhone",
        "status",
        "adminNote",
        "createdAt",
        "updatedAt"
      ]
