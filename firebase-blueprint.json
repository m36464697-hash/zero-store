{
  "entities": {
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Global storefront appearance, branding, logo, animated top bar features, currency, and operational settings managed by admins.",
      "type": "object",
      "properties": {
        "brandName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Storefront brand name."
        },
        "logoUrl": {
          "type": "string",
          "maxLength": 300000,
          "description": "Optional custom uploaded or external logo URL."
        },
        "heroTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Main hero headline."
        },
        "heroSubtitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 260,
          "description": "Hero supporting subtitle."
        },
        "heroCtaText": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "description": "Primary hero CTA label."
        },
        "heroImageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300000,
          "description": "Hero showcase image URL or compressed data URI."
        },
        "promoBannerText": {
          "type": "string",
          "maxLength": 140,
          "description": "Fallback top bar announcement copy."
        },
        "promoBannerActive": {
          "type": "boolean",
          "description": "Whether top animated feature bar is displayed."
        },
        "marqueeFeatures": {
          "type": "array",
          "description": "Bounded list of animated top-bar feature highlights (max 8)."
        },
        "primaryAccentColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "minLength": 7,
          "maxLength": 7,
          "description": "Hex accent color for primary actions."
        },
        "supportEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 120,
          "description": "Customer support email address."
        },
        "supportWhatsapp": {
          "type": "string",
          "maxLength": 40,
          "description": "Customer support phone or WhatsApp number."
        },
        "currencyCode": {
          "type": "string",
          "enum": ["EGP", "SAR", "AED", "USD"],
          "description": "Active storefront currency code."
        },
        "currencySymbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "description": "Currency display symbol."
        },
        "livePopupEnabled": {
          "type": "boolean",
          "description": "Enable bottom-left real-time purchase notifications."
        },
        "autoFulfillmentEnabled": {
          "type": "boolean",
          "description": "Manual admin order verification mode flag."
        },
        "footerAboutText": {
          "type": "string",
          "maxLength": 240,
          "description": "Storefront footer brand description."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "brandName",
        "logoUrl",
        "heroTitle",
        "heroSubtitle",
        "heroCtaText",
        "heroImageUrl",
        "promoBannerText",
        "promoBannerActive",
        "marqueeFeatures",
        "primaryAccentColor",
        "supportEmail",
        "supportWhatsapp",
        "currencyCode",
        "currencySymbol",
        "livePopupEnabled",
        "autoFulfillmentEnabled",
        "footerAboutText",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Dynamic storefront category managed by admins.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Category display name."
        },
        "description": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200,
          "description": "Category subtitle description."
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300000,
          "description": "Category artwork URL or compressed data URI."
        },
        "sortOrder": {
          "type": "number",
          "description": "Display order."
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether category is visible in storefront."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "name",
        "description",
        "imageUrl",
        "sortOrder",
        "isActive",
        "updatedAt"
      ]
    },
    "Product": {
      "title": "Product",
      "description": "Digital gaming top-up, gift card, subscription activation, or account delivery product with packages.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Display name of the game or card."
        },
        "subtitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Short subtitle describing delivery or platform."
        },
        "category": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 64,
          "description": "Category ID."
        },
        "region": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "description": "Supported store region."
        },
        "deliveryType": {
          "type": "string",
          "enum": ["direct_id", "voucher_code", "subscription_login", "account_delivery"],
          "description": "Order fulfillment mode configured by admin."
        },
        "requiresPlayerId": {
          "type": "boolean",
          "description": "Whether customer must supply an in-game Player ID."
        },
        "playerIdLabel": {
          "type": "string",
          "maxLength": 60,
          "description": "Input label for player identifier."
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 850000,
          "description": "High-resolution product artwork URL or compressed data URI."
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "minLength": 7,
          "maxLength": 7,
          "description": "Brand accent hex color."
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Show in featured storefront section."
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether product is visible for purchase."
        },
        "sortOrder": {
          "type": "number",
          "description": "Sort order in catalog."
        },
        "packages": {
          "type": "array",
          "description": "Bounded list of available top-up or gift card denominations (max 12)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "title",
        "subtitle",
        "category",
        "region",
        "deliveryType",
        "requiresPlayerId",
        "playerIdLabel",
        "imageUrl",
        "accentColor",
        "isFeatured",
        "isActive",
        "sortOrder",
        "packages",
        "updatedAt"
      ]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount code managed by admins.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_\\-]+$",
          "minLength": 2,
          "maxLength": 24,
          "description": "Uppercase coupon code."
        },
        "discountType": {
          "type": "string",
          "enum": ["percent", "fixed"],
          "description": "Percentage or fixed amount discount."
        },
        "discountValue": {
          "type": "number",
          "description": "Discount percentage or fixed currency value."
        },
        "minOrderAmount": {
          "type": "number",
          "description": "Minimum subtotal required to use coupon."
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether coupon is currently redeemable."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp."
        }
      },
      "required": [
        "code",
        "discountType",
        "discountValue",
        "minOrderAmount",
        "isActive",
        "updatedAt"
      ]
    },
    "PaymentMethod": {
      "title": "PaymentMethod",
      "description": "Electronic wallet payment method configured by admins.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Wallet name."
        },
        "walletNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 60,
          "description": "Target wallet phone number or IPA handle."
        },
        "accountHolder": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Registered recipient name."
        },
        "instructions": {
          "type": "string",
          "minLength": 4,
          "maxLength": 260,
          "description": "Transfer instructions displayed at checkout."
        },
        "feePercent": {
          "type": "number",
          "description": "Optional payment gateway fee percentage."
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "minLength": 7,
          "maxLength": 7,
          "description": "Brand color hex for wallet card."
        },
        "requiresManualReview": {
          "type": "boolean",
          "description": "Whether admin reviews payment manually before fulfillment."
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether wallet is selectable at checkout."
        },
        "sortOrder": {
          "type": "number",
          "description": "Display order."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "name",
        "walletNumber",
        "accountHolder",
        "instructions",
        "feePercent",
        "accentColor",
        "requiresManualReview",
        "isActive",
        "sortOrder",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order across direct top-up, digital codes, subscription account activation, or ready account delivery.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Owner Firebase Auth UID."
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Customer display name."
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 120,
          "description": "Customer email for receipt."
        },
        "orderNumber": {
          "type": "string",
          "pattern": "^ZN-[0-9]{5,10}$",
          "minLength": 8,
          "maxLength": 15,
          "description": "Auto-generated order & reference code."
        },
        "productId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Referenced Product document ID."
        },
        "productTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Product name snapshot."
        },
        "category": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 64,
          "description": "Product category ID snapshot."
        },
        "packageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Selected package ID."
        },
        "packageName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Selected denomination label."
        },
        "quantity": {
          "type": "number",
          "description": "Quantity purchased."
        },
        "unitPrice": {
          "type": "number",
          "description": "Price per unit."
        },
        "discountAmount": {
          "type": "number",
          "description": "Applied coupon/voucher discount amount."
        },
        "couponCode": {
          "type": "string",
          "maxLength": 32,
          "description": "Coupon or voucher code used if any."
        },
        "feeAmount": {
          "type": "number",
          "description": "Electronic wallet fee amount."
        },
        "totalAmount": {
          "type": "number",
          "description": "Final order amount."
        },
        "currencySymbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "description": "Currency symbol snapshot."
        },
        "paymentMethodId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Referenced PaymentMethod document ID or 'site_balance'."
        },
        "paymentMethodName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Payment method display label."
        },
        "walletSenderPhone": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "description": "Customer sender wallet phone or 'رصيد الحساب'."
        },
        "transactionRef": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "description": "Auto-generated order reference code."
        },
        "playerId": {
          "type": "string",
          "maxLength": 64,
          "description": "Target in-game Player ID if direct top-up."
        },
        "accountEmail": {
          "type": "string",
          "maxLength": 120,
          "description": "Customer account email/username submitted for subscription activation."
        },
        "accountPassword": {
          "type": "string",
          "maxLength": 120,
          "description": "Customer account password submitted for subscription activation."
        },
        "accountNotes": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional subscription login notes or 2FA instructions."
        },
        "deliveryType": {
          "type": "string",
          "enum": ["direct_id", "voucher_code", "subscription_login", "account_delivery"],
          "description": "Order fulfillment type."
        },
        "status": {
          "type": "string",
          "enum": ["pending_payment", "verifying", "processing", "completed", "failed"],
          "description": "Current order tracking status controlled by admin."
        },
        "deliveredCode": {
          "type": "string",
          "maxLength": 160,
          "description": "Delivered digital voucher PIN, top-up reference, or activation confirmation."
        },
        "deliveredAccountEmail": {
          "type": "string",
          "maxLength": 120,
          "description": "Delivered ready account email for account_delivery products."
        },
        "deliveredAccountPassword": {
          "type": "string",
          "maxLength": 120,
          "description": "Delivered ready account password for account_delivery products."
        },
        "adminNote": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional note from fulfillment team."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "userId",
        "customerName",
        "customerEmail",
        "orderNumber",
        "productId",
        "productTitle",
        "category",
        "packageId",
        "packageName",
        "quantity",
        "unitPrice",
        "discountAmount",
        "couponCode",
        "feeAmount",
        "totalAmount",
        "currencySymbol",
        "paymentMethodId",
        "paymentMethodName",
        "walletSenderPhone",
        "transactionRef",
        "playerId",
        "accountEmail",
        "accountPassword",
        "accountNotes",
        "deliveryType",
        "status",
        "deliveredCode",
        "deliveredAccountEmail",
        "deliveredAccountPassword",
        "adminNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicActivity": {
      "title": "PublicActivity",
